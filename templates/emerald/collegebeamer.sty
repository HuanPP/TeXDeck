% --- package options ---
% languages
\newcommand{\tocStr}{Table of Contents}
\newcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}

\DeclareOption{en}{
    \renewcommand{\tocStr}{Table of Contents}
    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
}

\newif\ifcollegebeamer@zh

% Chinese option
\DeclareOption{zh}{%
  \collegebeamer@zhtrue
  \AtEndOfPackage{%
    \RequirePackage{ifxetex}
    \RequirePackage{xeCJK}

    % TeXDeck: xeCJK otherwise treats curly quotes as CJK punctuation and pads
    % them to full width, which looks wrong in English text (dollar's -> dollar ' s).
    \xeCJKDeclareCharClass{Default}{"2018, "2019, "201C, "201D}
    
    % True bold/italic cuts shipped in font/ so \textbf, \emph, \textsl and the
    % frametitle bold series render with real weights (no silent regular fallback).
    \setmainfont[
      Path            = ./font/,
      BoldFont        = EBGaramond-Bold.otf,
      ItalicFont      = EBGaramond-Italic.otf,
      BoldItalicFont  = EBGaramond-BoldItalic.otf,
      SlantedFont     = EBGaramond-Italic.otf,
      BoldSlantedFont = EBGaramond-BoldItalic.otf
    ]{EBGaramond12-Regular.otf}
    \setsansfont[
      Path            = ./font/,
      BoldFont        = EBGaramond-Bold.otf,
      ItalicFont      = EBGaramond-Italic.otf,
      BoldItalicFont  = EBGaramond-BoldItalic.otf,
      SlantedFont     = EBGaramond-Italic.otf,
      BoldSlantedFont = EBGaramond-BoldItalic.otf
    ]{EBGaramond12-Regular.otf}


    % FandolKai: TeX Live / Overleaf 自带，按文件名加载，跨平台通用
    \setCJKmainfont{FandolKai-Regular}[
      Extension   = .otf,
      AutoFakeBold = true
    ]
    \setCJKsansfont{FandolKai-Regular}[
      Extension   = .otf,
      AutoFakeBold = true
    ]

    
    \renewcommand{\tocStr}{目录}
    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
    \ifxetex
    \else
      \PackageError{collegeBeamer}{请使用 XeLaTeX 编译此模板！}{}
    \fi
  }
}

% colleges & institutes
\newcommand{\maincolorRGB}{26,59,51}
\newcommand{\colorlogoPath}{src/brand/color-logo.png}
\newcommand{\translogoPath}{src/brand/trans-logo.png}
\newcommand{\backgroundPath}{src/brand/background.png}

\DeclareOption{bjtu}{
  \renewcommand{\maincolorRGB}{26,59,51}  % the theme's main color in RGB
  \renewcommand{\colorlogoPath}{src/brand/color-logo.png}  % path to the logo image with background color
  \renewcommand{\translogoPath}{src/brand/trans-logo.png}  % path to the logo image with transparent background
  \renewcommand{\backgroundPath}{src/brand/background.png}  % path to the background image
}

\ProcessOptions\relax

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% logo
\pgfdeclareimage[width=0.055\paperwidth]{colorlogo}{\colorlogoPath}
\pgfdeclareimage[width=0.055\paperwidth]{translogo}{\translogoPath}
\newcommand{\@makelogo}{colorlogo}

% logo top-right so frame titles can share the body text's left edge
\setbeamertemplate{headline}{\vspace{2mm}\hfill\pgfuseimage{\@makelogo}\hspace{0.04\paperwidth}}

% one left edge for frame title and body text (see frametitle leftskip below)
\setbeamersize{text margin left=10.5mm, text margin right=10.5mm}

% color
\definecolor{maincolor}{RGB}{\maincolorRGB}
% accent for links / b-commands: muted gold, tuned to sit with the emerald palette
% (name kept for backwards compatibility with the b-command family)
\definecolor{airforceblue}{RGB}{176, 141, 74}
\definecolor{morelightgray}{rgb}{0.9, 0.9, 0.9}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=darkgray, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}

% font
% \renewcommand{\familydefault}{\sfdefault}  % sans-serif
\usefonttheme{serif}

\AtEndOfPackage{%
  \ifcollegebeamer@zh
    \setbeamerfont{title}{series=\bfseries, size=\huge}
  \else
    \setbeamerfont{title}{series=\scshape, size=\huge}

  \fi
}

% lining tabular figures for data: EB Garamond defaults to oldstyle proportional
% digits, which hang below the baseline in charts and tables. Switch inside
% tikzpicture tick labels, tabulars and the outline numbers via \datafont.
\newcommand{\datafont}{\addfontfeature{Numbers={Lining,Monospaced}}}

\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{date}{size=\normalsize}

\setbeamerfont{frametitle}{series=\bfseries}
\setbeamerfont{framesubtitle}{series=\mdseries}
\setbeamerfont{footline}{size=\scriptsize}

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% footline: quiet page indicator bottom-right (title/TOC/QA pages suppress it)
\newcommand{\@footlinepayoff}{}  % optional extra footline text, empty by default
\setbeamertemplate{footline}{
    \hfill{\usebeamerfont{footline}\color{maincolor!60}\@footlinepayoff\insertframenumber\,/\,\inserttotalframenumber}\hspace{6mm}\vskip3mm
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, makes the footline background transparent
    \ifstrempty{#1}{
        \setbeamercolor{footline}{bg=}
    }{
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{} % default: transparent footline background

% block
\setbeamertemplate{blocks}[rounded]
\setbeamerfont{block title}{series=\centering, size=\small}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamercolor{block title}{fg=white, bg=maincolor!85}
\setbeamercolor{block body}{fg=darkgray, bg=maincolor!8}

% bullets
\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textemdash}
\setbeamertemplate{itemize subsubitem}{\ensuremath{\circ}}

% table of cotents
\setbeamertemplate{section in toc}{$\blacktriangleright$~\inserttocsection}  % section name format
\setbeamertemplate{subsection in toc}{}  % don't present subsection

% code bolck setting
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    commentstyle=\color{airforceblue},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
}

\lstset{style=mystyle}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame; guarded so nothing (not even a stray "0")
% prints before the first \section is defined
\makeatletter
    \pretocmd\beamer@checkframetitle{\framesubtitle{\ifnum\value{section}>0 \thesection \, \secname\fi}}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section page with the current section highlighted
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \themecolor{colorbg}
    \begin{frame}{\tocStr}
        \tableofcontents[currentsection]
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begin{frame}{\,}{\thesection \, \secname}
        \fontfamily{ptm}\selectfont
        \centering\textsl{\textbf{\textcolor{maincolor}{
            \large Section \thesection.\thesubsection
            \vskip15pt
            \LARGE \subsecname
        }}}
    \end{frame}
}

% --- page elements ---
% frame title & subtitle layout
\setbeamertemplate{frametitle}{
    \vspace*{-3.5ex}
    % leftskip=0: the box already starts at the 10.5mm text margin, so the
    % frame title shares one left edge with the body text
    \begin{beamercolorbox}[leftskip=0mm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\\
    \usebeamerfont{framesubtitle}\insertframesubtitle
    \end{beamercolorbox}
}

% title page
\setbeamertemplate{title page}{
    \hspace{-12mm}  % pull back the box in an inelegant way - but it works!
    \begin{beamercolorbox}[wd=0.9\textwidth, sep=10pt, leftskip=8mm]{title}
        {\usebeamerfont{title}\inserttitle}\\
        \vskip5pt{\usebeamerfont{subtitle}\insertsubtitle}\\
        \vskip5pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\
        \vskip5pt{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
    \end{beamercolorbox}
}

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        
        \begin{frame}{}
            \centering
            \begin{minipage}{\textwidth}
                \usebeamercolor[fg]{normal text}
                \centering
                {\Huge Q\,\&\,A\par}
                \vskip10pt
                {\Large \qaStr\par}
            \end{minipage}
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

% --- commands ---
% set colored hyperlinks command
\newcommand{\bhref}[2]{\textcolor{airforceblue}{\href{#1}{#2}}}

% centering paragraph statement
\newcommand{\centerstate}[1]{
    \centering
    \begin{columns}
        \begin{column}{0.8\textwidth}
            #1
        \end{column}
    \end{columns}
}

\newcommand{\tbf}[1]{\texttt{\textcolor{airforceblue}{[#1]}}}

% coloured textbf
\newcommand{\ctextbf}[1]{\textbf{\textcolor{maincolor}{#1}}}
\newcommand{\btextbf}[1]{\textbf{\textcolor{airforceblue}{#1}}}

% coloured textsl
\newcommand{\ctextsl}[1]{\textsl{\textcolor{maincolor}{#1}}}
\newcommand{\btextsl}[1]{\textsl{\textcolor{airforceblue}{#1}}}

% coloured emph
\newcommand{\cemph}[1]{\emph{\textcolor{maincolor}{#1}}}
\newcommand{\bemph}[1]{\emph{\textcolor{airforceblue}{#1}}}

% coloured texttt
\newcommand{\ctexttt}[1]{\texttt{\textcolor{maincolor}{#1}}}
\newcommand{\btexttt}[1]{\texttt{\textcolor{airforceblue}{#1}}}
