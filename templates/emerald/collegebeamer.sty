% --- package options ---
% languages
\newcommand{\tocStr}{Table of Contents}
\newcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}

\DeclareOption{en}{
    \renewcommand{\tocStr}{Table of Contents}
    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
}

\newif\ifcollegebeamer@zh

% Chinese option
\DeclareOption{zh}{%
  \collegebeamer@zhtrue
  \AtEndOfPackage{%
    \RequirePackage{ifxetex}
    \RequirePackage{xeCJK}

    % TeXDeck: xeCJK otherwise treats curly quotes as CJK punctuation and pads
    % them to full width, which looks wrong in English text (dollar's -> dollar ' s).
    \xeCJKDeclareCharClass{Default}{"2018, "2019, "201C, "201D}
    
    % True bold/italic cuts shipped in font/ so \textbf, \emph, \textsl and the
    % frametitle bold series render with real weights (no silent regular fallback).
    \setmainfont[
      Path            = ./font/,
      BoldFont        = EBGaramond-Bold.otf,
      ItalicFont      = EBGaramond-Italic.otf,
      BoldItalicFont  = EBGaramond-BoldItalic.otf,
      SlantedFont     = EBGaramond-Italic.otf,
      BoldSlantedFont = EBGaramond-BoldItalic.otf
    ]{EBGaramond12-Regular.otf}
    \setsansfont[
      Path            = ./font/,
      BoldFont        = EBGaramond-Bold.otf,
      ItalicFont      = EBGaramond-Italic.otf,
      BoldItalicFont  = EBGaramond-BoldItalic.otf,
      SlantedFont     = EBGaramond-Italic.otf,
      BoldSlantedFont = EBGaramond-BoldItalic.otf
    ]{EBGaramond12-Regular.otf}


    % FandolKai: TeX Live / Overleaf 自带，按文件名加载，跨平台通用。
    % AutoFakeSlant: the editorial theme sets subtitles/section names in
    % \itshape; Kai has no italic cut, so fake-slant it instead of letting
    % LaTeX warn and fall back. SmallCapsFont maps \scshape (kicker lines)
    % to the upright cut — CJK has no small caps, silence the substitution.
    % Prefer Noto/Source Han when installed (Docker ships fonts-noto-cjk);
    % fall back to Fandol Kai so a plain TeX Live still compiles.
    \IfFontExistsTF{Noto Serif CJK SC}{%
      \setCJKmainfont{Noto Serif CJK SC}[BoldFont = {* Bold}, AutoFakeSlant = 0.15,
        SmallCapsFont = {Noto Serif CJK SC}, SmallCapsFeatures = {}]%
    }{\IfFontExistsTF{Source Han Serif SC}{%
      \setCJKmainfont{Source Han Serif SC}[BoldFont = {* Bold}, AutoFakeSlant = 0.15,
        SmallCapsFont = {Source Han Serif SC}, SmallCapsFeatures = {}]%
    }{%
      \setCJKmainfont{FandolKai-Regular}[
        Extension   = .otf,
        AutoFakeBold = true,
        AutoFakeSlant = 0.15,
        SmallCapsFont = FandolKai-Regular,
        SmallCapsFeatures = {}
      ]
    }}
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \setCJKsansfont{Noto Sans CJK SC}[BoldFont = {* Bold}, AutoFakeSlant = 0.15,
        SmallCapsFont = {Noto Sans CJK SC}, SmallCapsFeatures = {}]%
    }{\IfFontExistsTF{Source Han Sans SC}{%
      \setCJKsansfont{Source Han Sans SC}[BoldFont = {* Bold}, AutoFakeSlant = 0.15,
        SmallCapsFont = {Source Han Sans SC}, SmallCapsFeatures = {}]%
    }{%
      \setCJKsansfont{FandolKai-Regular}[
        Extension   = .otf,
        AutoFakeBold = true,
        AutoFakeSlant = 0.15,
        SmallCapsFont = FandolKai-Regular,
        SmallCapsFeatures = {}
      ]
    }}

    
    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
    \ifxetex
    \else
      \PackageError{collegeBeamer}{Compile this template with XeLaTeX}{}
    \fi
  }
}

% colleges & institutes
\newcommand{\maincolorRGB}{26,59,51}
\newcommand{\colorlogoPath}{src/brand/color-logo.png}
\newcommand{\translogoPath}{src/brand/trans-logo.png}
\newcommand{\backgroundPath}{src/brand/background.png}

\DeclareOption{bjtu}{
  \renewcommand{\maincolorRGB}{26,59,51}  % the theme's main color in RGB
  \renewcommand{\colorlogoPath}{src/brand/color-logo.png}  % path to the logo image with background color
  \renewcommand{\translogoPath}{src/brand/trans-logo.png}  % path to the logo image with transparent background
  \renewcommand{\backgroundPath}{src/brand/background.png}  % path to the background image
}

\ProcessOptions\relax

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% logo
% EDITORIAL identity: the brand mark appears on the title page only (masthead
% position, top-left). Content pages carry no logo — the oversized serif
% frametitle and whitespace are the chrome.
\pgfdeclareimage[width=0.055\paperwidth]{colorlogo}{\colorlogoPath}
\pgfdeclareimage[width=0.055\paperwidth]{translogo}{\translogoPath}
\pgfdeclareimage[width=0.045\paperwidth]{titlelogo}{\colorlogoPath}
\newcommand{\@makelogo}{colorlogo}

% empty headline: frametitle template below owns the top whitespace
\setbeamertemplate{headline}{}

% one left edge for frame title and body text (see frametitle leftskip below)
\setbeamersize{text margin left=10.5mm, text margin right=10.5mm}

% color
\definecolor{maincolor}{RGB}{\maincolorRGB}
% accent for links / b-commands: muted gold, tuned to sit with the emerald palette
% (name kept for backwards compatibility with the b-command family)
\definecolor{airforceblue}{RGB}{176, 141, 74}
\definecolor{morelightgray}{rgb}{0.9, 0.9, 0.9}
% warm near-black ink for display typography (editorial identity)
\definecolor{inkblack}{RGB}{33, 32, 28}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=darkgray, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

\setbeamercolor{title}{fg=inkblack}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}
\setbeamercolor{frametitle}{fg=inkblack}
\setbeamercolor{framesubtitle}{fg=maincolor}

% font
% \renewcommand{\familydefault}{\sfdefault}  % sans-serif
\usefonttheme{serif}

% display-size title: oversized EB Garamond bold, book-jacket scale
\AtEndOfPackage{%
  \setbeamerfont{title}{series=\bfseries, size={\fontsize{30}{36}\selectfont}}
}

% lining tabular figures for data: EB Garamond defaults to oldstyle proportional
% digits, which hang below the baseline in charts and tables. Switch inside
% tikzpicture tick labels, tabulars and the outline numbers via \datafont.
\newcommand{\datafont}{\addfontfeature{Numbers={Lining,Monospaced}}}

\setbeamerfont{subtitle}{series=\mdseries, shape=\itshape, size=\large}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{date}{size=\normalsize}

% oversized serif frametitle in near-black ink; section line in emerald italic
\setbeamerfont{frametitle}{series=\bfseries, size={\fontsize{17.5}{21}\selectfont}}
\setbeamerfont{framesubtitle}{series=\mdseries, shape=\itshape, size=\small}
\setbeamerfont{footline}{size=\scriptsize}

% letterspaced small-caps helper for kickers / bylines (EB Garamond has real
% smcp); lining figures so digits sit flush with the caps
\newcommand{\kickerfont}{\scshape\addfontfeature{LetterSpace=14, Numbers=Lining}}

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% footline: quiet page indicator bottom-right (title/TOC/QA pages suppress it)
\newcommand{\@footlinepayoff}{}  % optional extra footline text, empty by default
\setbeamertemplate{footline}{
    \hfill{\usebeamerfont{footline}\datafont\color{maincolor!60}\@footlinepayoff\insertframenumber\,/\,\inserttotalframenumber}\hspace{6mm}\vskip3mm
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, makes the footline background transparent
    \ifstrempty{#1}{
        \setbeamercolor{footline}{bg=}
    }{
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{} % default: transparent footline background

% block: quiet editorial panel — small-caps emerald title over a faint tint,
% squared corners, no heavy colored bar
\setbeamertemplate{blocks}[default]
\setbeamerfont{block title}{shape=\scshape, size=\small}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamercolor{block title}{fg=maincolor, bg=maincolor!12}
\setbeamercolor{block body}{fg=darkgray, bg=maincolor!4}

% lists: en-dash markers in emerald, loose editorial leading
\setbeamertemplate{itemize item}{\color{maincolor}\textendash}
\setbeamertemplate{itemize subitem}{\color{maincolor!65}\textendash}
\setbeamertemplate{itemize subsubitem}{\color{maincolor!65}\ensuremath{\circ}}
\setbeamertemplate{enumerate item}{{\color{maincolor}\datafont\insertenumlabel.}}
\setbeamertemplate{itemize/enumerate body begin}{\linespread{1.15}\selectfont}

% table of cotents (@ is a letter inside a package, so \two@digits is safe here)
\setbeamertemplate{section in toc}{{\color{maincolor}\datafont\two@digits{\inserttocsectionnumber}}\;\;\inserttocsection}  % section name format
\setbeamertemplate{subsection in toc}{}  % don't present subsection

% code bolck setting
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    commentstyle=\color{airforceblue},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
}

\lstset{style=mystyle}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame; guarded so nothing (not even a stray "0")
% prints before the first \section is defined.
% Editorial form: "01 · Section Name" with lining figures.
\makeatletter
    \pretocmd\beamer@checkframetitle{\framesubtitle{\ifnum\value{section}>0 {\datafont\two@digits{\value{section}}}\;\textperiodcentered\;\secname\fi}}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% --- section transition page (EDITORIAL identity) ---
% Full-bleed emerald page: ghost section numeral (huge, 15% white) on the
% right, letterspaced gold kicker + white display-italic section name low-left.
\makeatletter
\newcommand{\sectionframe}{%
    \begingroup
    \setbeamertemplate{footline}{}%
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \fill[maincolor] (current page.south west) rectangle (current page.north east);
            \node[anchor=east, inner sep=0pt]
                at ([xshift=-9mm, yshift=4mm]current page.east)
                {\color{white!15!maincolor}\fontsize{140}{140}\selectfont\itshape\datafont\two@digits{\value{section}}};
            \node[anchor=south west, inner sep=0pt, text width=0.72\paperwidth, align=flush left]
                at ([xshift=10.5mm, yshift=13mm]current page.south west) {%
                    {\footnotesize\kickerfont\color{airforceblue}Part \two@digits{\value{section}}\par}%
                    \vskip7pt
                    {\color{white!60!maincolor}\rule{60pt}{0.8pt}\par}%
                    \vskip11pt
                    {\fontsize{25}{30}\selectfont\itshape\color{white}\insertsection\par}%
                };
        \end{tikzpicture}%
    \end{frame}
    \endgroup
}
\makeatother

% default section behaviour when used standalone (the TeXDeck prompt template
% disables this and calls \sectionframe explicitly after each \section)
\AtBeginSection[]
{
    \sectionframe
}

% subsection title page: quiet paper page, gold kicker + emerald italic name
\AtBeginSubsection[]
{
    \begin{frame}[plain]
        \vspace*{\fill}
        {\footnotesize\kickerfont\color{airforceblue}\strsubsec\par}
        \vskip6pt
        {\color{maincolor}\rule{60pt}{0.8pt}\par}
        \vskip10pt
        {\fontsize{20}{25}\selectfont\itshape\color{maincolor}\subsecname\par}
        \vspace*{\fill}\vspace*{\fill}
    \end{frame}
}

% --- page elements ---
% frame title & subtitle layout: oversized serif over emerald italic section
% line, generous top whitespace, NO rule — whitespace is the chrome.
\setbeamertemplate{frametitle}{
    \vspace*{6.5mm}
    % leftskip=0: the box already starts at the 10.5mm text margin, so the
    % frame title shares one left edge with the body text
    \begin{beamercolorbox}[leftskip=0mm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\\[1.5pt]
    {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
    \end{beamercolorbox}
    \vspace*{1.5mm}
}

% title page: asymmetric editorial composition anchored LOW-LEFT.
% Thin emerald rule above a display-size title (max 0.62\paperwidth wide),
% emerald italic subtitle, letterspaced small-caps byline. Empty
% subtitle/author/institute rows vanish entirely (wave-1 guards preserved).
% Brand mark sits alone in the masthead position (top-left).
\makeatletter
\setbeamertemplate{title page}{
    \begin{tikzpicture}[remember picture, overlay]
        \node[anchor=north west, inner sep=0pt]
            at ([xshift=10.5mm, yshift=-7mm]current page.north west)
            {\pgfuseimage{titlelogo}};
        \node[anchor=south west, inner sep=0pt, text width=0.62\paperwidth, align=flush left]
            at ([xshift=10.5mm, yshift=11mm]current page.south west) {%
                {\color{maincolor}\rule{60pt}{1.2pt}\par}%
                \vskip10pt
                {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
                \ifdefempty{\insertsubtitle}{}{%
                    \vskip8pt{\usebeamerfont{subtitle}\color{maincolor}\insertsubtitle\par}}%
                \vskip13pt
                {\footnotesize\kickerfont\color{inkblack!60}%
                    \ifdefempty{\beamer@shortauthor}{}{\insertauthor\ \ \textperiodcentered\ \ }%
                    \ifdefempty{\beamer@shortinstitute}{}{\insertinstitute\ \ \textperiodcentered\ \ }%
                    \insertdate\par}%
            };
    \end{tikzpicture}%
}
\makeatother

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page: full-bleed emerald with a ghost ampersand, low-left thank-you
% block — mirrors the title page composition to close the deck.
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \begin{frame}[plain]
            \begin{tikzpicture}[remember picture, overlay]
                \fill[maincolor] (current page.south west) rectangle (current page.north east);
                \node[anchor=east, inner sep=0pt]
                    at ([xshift=-18mm, yshift=6mm]current page.east)
                    {\color{white!15!maincolor}\fontsize{170}{170}\selectfont\itshape\&};
                \node[anchor=south west, inner sep=0pt, text width=0.72\paperwidth, align=flush left]
                    at ([xshift=10.5mm, yshift=13mm]current page.south west) {%
                        {\color{white!60!maincolor}\rule{60pt}{0.8pt}\par}%
                        \vskip11pt
                        {\fontsize{25}{30}\selectfont\color{white}Q\,\&\,A\par}%
                        \vskip9pt
                        {\normalsize\color{white!80!maincolor}\qaStr\par}%
                    };
            \end{tikzpicture}%
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

% --- commands ---
% set colored hyperlinks command
\newcommand{\bhref}[2]{\textcolor{airforceblue}{\href{#1}{#2}}}

% centering paragraph statement
\newcommand{\centerstate}[1]{
    \centering
    \begin{columns}
        \begin{column}{0.8\textwidth}
            #1
        \end{column}
    \end{columns}
}

\newcommand{\tbf}[1]{\texttt{\textcolor{airforceblue}{[#1]}}}

% coloured textbf
\newcommand{\ctextbf}[1]{\textbf{\textcolor{maincolor}{#1}}}
\newcommand{\btextbf}[1]{\textbf{\textcolor{airforceblue}{#1}}}

% coloured textsl
\newcommand{\ctextsl}[1]{\textsl{\textcolor{maincolor}{#1}}}
\newcommand{\btextsl}[1]{\textsl{\textcolor{airforceblue}{#1}}}

% coloured emph
\newcommand{\cemph}[1]{\emph{\textcolor{maincolor}{#1}}}
\newcommand{\bemph}[1]{\emph{\textcolor{airforceblue}{#1}}}

% coloured texttt
\newcommand{\ctexttt}[1]{\texttt{\textcolor{maincolor}{#1}}}
\newcommand{\btexttt}[1]{\texttt{\textcolor{airforceblue}{#1}}}
