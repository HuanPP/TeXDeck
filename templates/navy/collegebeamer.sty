\newcommand{\bhref}[2]{\textcolor{airforceblue}{\href{#1}{#2}}}

% centering paragraph statement
\newcommand{\centerstate}[1]{
    \centering
    \begin{columns}
        \begin{column}{0.8\textwidth}
            #1
        \end{column}
    \end{columns}
}

\newcommand{\tbf}[1]{\texttt{\textcolor{airforceblue}{[#1]}}}

