\newif\ifcollegebeamer@zh

% Chinese option
\DeclareOption{zh}{%
  \collegebeamer@zhtrue
  \AtEndOfPackage{%
    \RequirePackage{ifxetex}
    \RequirePackage{xeCJK}

    % TeXDeck: xeCJK otherwise treats curly quotes as CJK punctuation and pads
    % them to full width, which looks wrong in English text (dollar's -> dollar ' s).
    \xeCJKDeclareCharClass{Default}{"2018, "2019, "201C, "201D}

    % Real Bold/Italic faces + lining figures (oldstyle digits must not leak
    % into charts, tables, or page numbers).
    \setmainfont[
      Path       = ./font/,
      BoldFont   = EBGaramond-Bold.otf,
      ItalicFont = EBGaramond-Italic.otf,
      Numbers    = Lining
    ]{EBGaramond12-Regular.otf}
    \setsansfont[
      Path       = ./font/,
      BoldFont   = EBGaramond-Bold.otf,
      ItalicFont = EBGaramond-Italic.otf,
      Numbers    = Lining
    ]{EBGaramond12-Regular.otf}
    
    % Finance-style Chinese typography: Song for body, Hei for emphasis.
    % Prefer Noto/Source Han when installed (Docker ships fonts-noto-cjk);
    % fall back to FandolSong so a plain TeX Live still compiles.
    \IfFontExistsTF{Noto Serif CJK SC}{%
      \setCJKmainfont{Noto Serif CJK SC}[BoldFont = {* Bold}]%
    }{\IfFontExistsTF{Source Han Serif SC}{%
      \setCJKmainfont{Source Han Serif SC}[BoldFont = {* Bold}]%
    }{%
      \setCJKmainfont{FandolSong-Regular}[
        Extension    = .otf,
        AutoFakeBold = true
      ]
    }}
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \setCJKsansfont{Noto Sans CJK SC}[BoldFont = {* Bold}]%
    }{\IfFontExistsTF{Source Han Sans SC}{%
      \setCJKsansfont{Source Han Sans SC}[BoldFont = {* Bold}]%
    }{%
      \setCJKsansfont{FandolSong-Regular}[
        Extension    = .otf,
        AutoFakeBold = true
      ]
    }}

    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
    \ifxetex
    \else
      \PackageError{collegeBeamer}{Compile this template with XeLaTeX}{}
    \fi
  }
}

% colleges & institutes
\newcommand{\maincolorRGB}{18, 52, 86}
\newcommand{\colorlogoPath}{src/brand/color-logo.png}
\newcommand{\translogoPath}{src/brand/trans-logo.png}
\newcommand{\backgroundPath}{src/brand/background.png}

\DeclareOption{bjtu}{
  \renewcommand{\maincolorRGB}{18, 52, 86}  % the theme's main color in RGB
  \renewcommand{\colorlogoPath}{src/brand/color-logo.png}  % path to the logo image with background color
  \renewcommand{\translogoPath}{src/brand/trans-logo.png}  % path to the logo image with transparent background
  \renewcommand{\backgroundPath}{src/brand/background.png}  % path to the background image
}

\ProcessOptions\relax

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% logo
% Logos fit a box of at most #2 x #3 and keep their aspect ratio, so a logo
% of any shape (a custom one included) stays inside its slot.
\newcommand{\tddeclarelogo}[4]{%
  \setbox0=\hbox{\includegraphics[width=#2,height=#3,keepaspectratio]{#4}}%
  \edef\td@logo@args{[width=\the\wd0,height=\the\ht0]{#1}{#4}}%
  \expandafter\pgfdeclareimage\td@logo@args}
\tddeclarelogo{colorlogo}{2.5\dimexpr0.06\paperwidth\relax}{0.06\paperwidth}{\colorlogoPath}
\tddeclarelogo{translogo}{2.5\dimexpr0.06\paperwidth\relax}{0.06\paperwidth}{\translogoPath}
% small knockout logo living inside the navy frametitle band (right end):
% the visible mark is 0.37cm high, a wide one may grow leftwards to 1.2cm
\tddeclarelogo{bandlogo}{1.2cm}{0.37cm}{\translogoPath}
\newcommand{\@makelogo}{colorlogo}

% no standalone headline: the brand mark sits inside the frametitle band,
% so content starts on a clean grid directly below the band
\setbeamertemplate{headline}{}

% color
\definecolor{maincolor}{RGB}{\maincolorRGB}
\definecolor{airforceblue}{RGB}{94, 118, 145}
\definecolor{morelightgray}{RGB}{244, 246, 249}
\definecolor{reporttext}{RGB}{40, 48, 61}
\definecolor{reportmuted}{RGB}{110, 121, 136}
\definecolor{reportline}{RGB}{214, 220, 228}
% light steel for secondary text sitting ON the navy band / panels
\definecolor{bandsteel}{RGB}{169, 184, 201}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=reporttext, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=reporttext}
\setbeamercolor{date}{fg=reportmuted}
% boardroom band: white title on navy, steel section tag on navy
\setbeamercolor{frametitle}{fg=white, bg=maincolor}
\setbeamercolor{framesubtitle}{fg=bandsteel}

% font
\renewcommand{\familydefault}{\sfdefault}
\usefonttheme{professionalfonts}

\AtEndOfPackage{%
  \ifcollegebeamer@zh
    \setbeamerfont{title}{series=\bfseries, size=\LARGE}
  \else
    \setbeamerfont{title}{series=\bfseries, size=\LARGE}
  \fi
}

\setbeamerfont{subtitle}{series=\mdseries, size=\small}
\setbeamerfont{author}{size=\small}
\setbeamerfont{date}{size=\footnotesize}

\setbeamerfont{frametitle}{series=\bfseries, size=\large}
\setbeamerfont{framesubtitle}{series=\mdseries, size=\footnotesize}
\setbeamerfont{footline}{size=\tiny}

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% footline: full-width navy progress hairline (filled fraction = current/total
% frames), then short title left + page N/M right in muted report ink
\newcommand{\@footlinepayoff}{\insertshorttitle}
\setbeamertemplate{footline}{%
    \nointerlineskip%
    \dimen@=\paperwidth
    \ifnum\inserttotalframenumber>0
      \dimen@=\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax
    \fi
    \ifdim\dimen@>\paperwidth \dimen@=\paperwidth\fi
    \hbox{%
      {\color{maincolor}\vrule width \dimen@ height 0.8pt depth 0pt}%
      {\color{reportline}\vrule width \dimexpr\paperwidth-\dimen@\relax height 0.8pt depth 0pt}%
    }%
    \nointerlineskip%
    \begin{beamercolorbox}[wd=\paperwidth, ht=4mm, dp=2.5mm, leftskip=0.9cm, rightskip=0.9cm]{footline}
    \usebeamerfont{footline}\color{reportmuted}\insertshorttitle\hfill\insertframenumber\,/\,\inserttotalframenumber
    \end{beamercolorbox}%
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, makes footline background transparent
    \ifstrempty{#1}{
        \setbeamercolor{footline}{bg=}
    }{
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{} % default: transparent footline background

% block
\setbeamertemplate{blocks}[rounded]
\setbeamerfont{block title}{series=\bfseries, size=\footnotesize}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamercolor{block title}{fg=maincolor, bg=morelightgray}
\setbeamercolor{block body}{fg=reporttext, bg=morelightgray}

% bullets: small crisp navy squares (report registers), steel second level
\setbeamertemplate{itemize item}{\raisebox{0.24ex}{\textcolor{maincolor}{\rule{0.72ex}{0.72ex}}}}
\setbeamertemplate{itemize subitem}{\raisebox{0.24ex}{\textcolor{airforceblue}{\rule{0.55ex}{0.55ex}}}}
\setbeamertemplate{itemize subsubitem}{\textcolor{reportmuted}{\tiny$\circ$}}

% table of contents: report-style numbered rows (01 02 ...), steel numerals;
% non-current sections render muted on section pages
\setbeamertemplate{section in toc}{%
    {\color{airforceblue}\makebox[2.0em][l]{\ifnum\inserttocsectionnumber<10 0\fi\inserttocsectionnumber}}%
    {\color{reporttext}\inserttocsection}}
\setbeamertemplate{section in toc shaded}{%
    {\color{reportmuted}\makebox[2.0em][l]{\ifnum\inserttocsectionnumber<10 0\fi\inserttocsectionnumber}\inserttocsection}}
\setbeamertemplate{subsection in toc}{}  % don't present subsection

% code bolck setting
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{airforceblue},
    keywordstyle=\color{maincolor},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
    frame=single,
    rulecolor=\color{reportline},
}

\lstset{style=mystyle}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame -- only once a \section exists, so no
% stray section number ("0") appears on pre-section frames like the outline
\makeatletter
    \pretocmd\beamer@checkframetitle{\ifnum\value{section}>0 \framesubtitle{\thesection \, \secname}\fi}{}{}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section page, boardroom divider: left third = solid navy panel carrying the
% big white section number + name; right two thirds = white agenda with the
% current section highlighted. (Template packs may override via \AtBeginSection.)
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            % 2pt bleed on the outer edges so no white hairline survives rasterizing
            \fill[maincolor] ([xshift=-2pt, yshift=2pt]current page.north west)
                rectangle ([xshift=0.34\paperwidth, yshift=-2pt]current page.south west);
            \node[anchor=north west, inner sep=0pt, text=white]
                at ([xshift=0.9cm, yshift=-1.7cm]current page.north west)
                {\fontsize{44}{44}\selectfont\bfseries \ifnum\thesection<10 0\fi\thesection};
            \draw[bandsteel, line width=0.6pt]
                ([xshift=0.9cm, yshift=-3.55cm]current page.north west) -- ++(1.15cm,0);
            \node[anchor=north west, inner sep=0pt, text=white, font=\large\bfseries,
                  text width=\dimexpr0.34\paperwidth-1.8cm\relax]
                at ([xshift=0.9cm, yshift=-3.95cm]current page.north west) {\secname};
        \end{tikzpicture}%
        \hspace*{\dimexpr0.34\paperwidth+0.1cm\relax}%
        \begin{minipage}{\dimexpr0.66\paperwidth-2.1cm\relax}
            {\footnotesize\color{airforceblue}\tocStr}\\[0.4em]
            {\color{reportline}\rule{\linewidth}{0.4pt}}
            \vspace{0.6em}
            \tableofcontents[currentsection]
        \end{minipage}
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begin{frame}{\,}{\thesection \, \secname}
        \fontfamily{\sfdefault}\selectfont
        \centering\textbf{\textcolor{maincolor}{
            \large Section \thesection.\thesubsection
            \vskip12pt
            \LARGE \subsecname
        }}
    \end{frame}
}

% --- page elements ---
% frame title: full-width navy band across the top of every content frame.
% White EB Garamond bold title left; section tag in light steel right-aligned;
% small knockout logo at the right end of the band.
\setbeamertemplate{frametitle}{%
    \nointerlineskip%
    \begin{beamercolorbox}[wd=\paperwidth, ht=0.70cm, dp=0.45cm, leftskip=0.9cm, rightskip=0.9cm]{frametitle}%
        \usebeamerfont{frametitle}\insertframetitle%
        \hfill
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
        % mark centred 0.114cm above the baseline, 0.9cm + 0.28cm from the right edge
        \hspace{0.575cm}\smash{\raisebox{\dimexpr0.1137cm-0.5\height\relax}{\pgfuseimage{bandlogo}}}\hspace{0.282cm}%
    \end{beamercolorbox}%
    \vskip0.20cm%
}

% title page
\setbeamertemplate{title page}{
    \hspace{-12mm}  % pull back the box in an inelegant way - but it works!
    \begin{beamercolorbox}[wd=0.9\textwidth, sep=10pt, leftskip=8mm]{title}
        {\usebeamerfont{title}\inserttitle}\\
        \vskip6pt{\usebeamerfont{subtitle}\textcolor{reportmuted}{\insertsubtitle}}\\
        \vskip8pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\
        \vskip4pt{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
    \end{beamercolorbox}
}

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        % paint the canvas too, so no light sliver of default background
        % shows at the paper edges of the full-bleed navy page
        \setbeamercolor{background canvas}{bg=maincolor}

        \begin{frame}{}
            \centering
            \begin{minipage}{\textwidth}
                \usebeamercolor[fg]{normal text}
                \centering
                \Huge Q \& A
                \vskip10pt
                \Large \qaStr
            \end{minipage}
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

