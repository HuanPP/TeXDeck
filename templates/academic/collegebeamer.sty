\ProvidesPackage{collegeBeamer}

% required packages
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{listings}
\RequirePackage{graphicx}
\RequirePackage{geometry}
\RequirePackage{amsfonts, amsmath, bm, oldgerm, lmodern}  % math
\RequirePackage{verbatim}
\RequirePackage{animate}
\RequirePackage{xcolor}

% --- package options ---
% languages
\newcommand{\tocStr}{Table of Contents}
\newcommand{\qaStr}{\textit{Thank you for your attention. \\ Questions and discussion are welcome.}}

\DeclareOption{en}{
    \renewcommand{\tocStr}{Table of Contents}
    \renewcommand{\qaStr}{\textit{Thank you for your attention. \\ Questions and discussion are welcome.}}
}

% colleges & institutes
\newcommand{\maincolorRGB}{128, 57, 61}
\newcommand{\colorlogoPath}{src/brand/color-logo.png}
\newcommand{\translogoPath}{src/brand/trans-logo.png}
\newcommand{\backgroundPath}{src/brand/background.png}

\DeclareOption{bjtu}{
  \renewcommand{\maincolorRGB}{128, 57, 61}  % the theme's main color in RGB
  \renewcommand{\colorlogoPath}{src/brand/color-logo.png}  % path to the logo image with background color
  \renewcommand{\translogoPath}{src/brand/trans-logo.png}  % path to the logo image with transparent background
  \renewcommand{\backgroundPath}{src/brand/background.png}  % path to the background image
}

\ProcessOptions\relax

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% logo (title page only -- content pages carry no logo in this pack)
\pgfdeclareimage[width=0.09\paperwidth]{colorlogo}{\colorlogoPath}
\pgfdeclareimage[width=0.09\paperwidth]{translogo}{\translogoPath}
\pgfdeclareimage[width=0.05\paperwidth]{titlelogo}{\colorlogoPath}
\newcommand{\@makelogo}{colorlogo}

\setbeamertemplate{headline}{} % no per-slide logo: classic university-press restraint

% one classic text margin shared by frame titles and body
\setbeamersize{text margin left=1.6cm, text margin right=1.6cm}

% color
\definecolor{maincolor}{RGB}{\maincolorRGB}
\definecolor{airforceblue}{rgb}{0.36, 0.54, 0.66}
\definecolor{morelightgray}{rgb}{0.9, 0.9, 0.9}

% double hairline rule ornament: #1 = colour, #2 = width
% (two 0.4pt rules 1.5pt apart -- the pack's signature classic ornament)
\newcommand{\deckrules}[2]{%
    \leavevmode\vbox{\color{#1}%
        \hrule width #2 height 0.4pt
        \vskip1.5pt
        \hrule width #2 height 0.4pt}%
}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
        \setbeamercolor{frametitle}{fg=white}
        \setbeamercolor{framesubtitle}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=darkgray, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
        \setbeamercolor{frametitle}{fg=black!78}
        \setbeamercolor{framesubtitle}{fg=black!45}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}

% font
% \renewcommand{\familydefault}{\sfdefault}  % sans-serif
\usefonttheme{serif}

% title is set as letterspaced small caps by the title-page template, so the
% weight stays medium (bold letterspaced caps would read heavy, not bookish)
\setbeamerfont{title}{series=\mdseries, size=\fontsize{24}{30}\selectfont}

\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize}
\setbeamerfont{author}{size=\small}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}

\setbeamerfont{frametitle}{series=\bfseries, size=\fontsize{15}{18}\selectfont}
\setbeamerfont{framesubtitle}{series=\mdseries, size=\footnotesize}
\setbeamerfont{footline}{size=\scriptsize}

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% footline: centered book-style folio "– n / N –" (suppressed on title/section/
% QA pages via the \begingroup overrides around those frames)
\newcommand{\@footlinepayoff}{%
    \textendash\enspace\insertframenumber\,/\,\inserttotalframenumber\enspace\textendash}
\setbeamertemplate{footline}{
    \begin{beamercolorbox}[wd=\textwidth, ht=4.5mm, dp=3.5mm, center]{footline}
    \usebeamerfont{footline}\@footlinepayoff
    \end{beamercolorbox}
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, resets the footline to its plain (no background) look
    \ifstrempty{#1}{
        \renewcommand{\@footlinepayoff}{%
            \textendash\enspace\insertframenumber\,/\,\inserttotalframenumber\enspace\textendash}
        \setbeamercolor{footline}{fg=darkgray!70, bg=}
    }{
        \renewcommand{\@footlinepayoff}{%
            \textendash\enspace\insertframenumber\,/\,\inserttotalframenumber\enspace\textendash}
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\setbeamercolor{footline}{fg=darkgray!70, bg=}  % default: subtle page numbers

% block (kept strictly on the maincolor palette; squared corners + maroon
% title on a light strip -- bookish, deliberately NOT a solid banded header)
\setbeamertemplate{blocks}[default]
\setbeamerfont{block title}{series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamercolor{block title}{fg=maincolor, bg=maincolor!12}
\setbeamercolor{block body}{fg=darkgray, bg=maincolor!4}
\setbeamercolor{block title alerted}{fg=maincolor!75!black, bg=maincolor!16}
\setbeamercolor{block body alerted}{fg=darkgray, bg=maincolor!5}
\setbeamercolor{block title example}{fg=maincolor!60!black, bg=maincolor!60!black!10}
\setbeamercolor{block body example}{fg=darkgray, bg=maincolor!60!black!4}

% bullets: classic round bullet in maroon; open circle, then centred dot, in gray
\setbeamertemplate{itemize item}{\textcolor{maincolor}{\textbullet}}
\setbeamertemplate{itemize subitem}{\textcolor{black!50}{\ensuremath{\circ}}}
\setbeamertemplate{itemize subsubitem}{\textcolor{black!50}{\textperiodcentered}}

% table of contents: maroon roman numerals, dark entry text, book style
\setbeamertemplate{section in toc}{%
    {\color{maincolor}\makebox[2em][r]{\MakeUppercase{\romannumeral\inserttocsectionnumber}.}}%
    \hskip0.8em{\color{black!75}\inserttocsection}}
\setbeamertemplate{subsection in toc}{}  % don't present subsection

% code bolck setting
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    commentstyle=\color{airforceblue},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
}

\lstset{style=mystyle}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents a section label on each frame (roman numeral + section name, shown
% right-aligned in small caps on the title line); suppressed before the first
% \section so no stray label appears on early frames (e.g. the Outline page)
\makeatletter
    \pretocmd\beamer@checkframetitle{\framesubtitle{\ifnum\value{section}>0 \Roman{section}\,\textperiodcentered\,\secname\fi}}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section divider: full-bleed maroon page -- small roman numeral over a short
% centered rule, section name in centered letterspaced small caps, second rule
% below (the same symmetric double-rule ornament language as the title page)
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \themecolor{colorbg}
    \begin{frame}
        \centering
        {\fontsize{13}{16}\selectfont\color{white!85!maincolor}\Roman{section}\par}
        \vskip3.5mm
        \deckrules{white!70!maincolor}{28mm}\par
        \vskip6mm
        {\fontsize{20}{27}\selectfont\scshape
         \ifdefined\addfontfeatures\addfontfeatures{LetterSpace=8.0}\fi
         \color{white}\secname\par}
        \vskip6mm
        \deckrules{white!70!maincolor}{28mm}\par
    \end{frame}
    \endgroup
}

% subsection title page (same ornament language, on paper)
\AtBeginSubsection[]
{
    \begin{frame}{\,}
        \centering
        {\small\color{maincolor}Section \thesection.\thesubsection\par}
        \vskip3mm
        \deckrules{maincolor!60}{28mm}\par
        \vskip5mm
        {\LARGE\scshape\color{maincolor}\subsecname\par}
    \end{frame}
}

% --- page elements ---
% frame title: dark serif bold, section label right-aligned in letterspaced
% small caps, and a full-text-width double hairline (0.4pt + 0.4pt, 1.5pt
% apart) beneath -- the pack's signature rule ornament, repeated per frame
\newbox\decklabelbox
\setbeamertemplate{frametitle}{
    \vskip1.6ex
    \begin{beamercolorbox}[wd=\textwidth]{frametitle}
        % measure the section label first so a long frame title wraps inside
        % the remaining width instead of overflowing the line
        \setbox\decklabelbox=\hbox{%
            \usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
            \scshape\ifdefined\addfontfeatures\addfontfeatures{LetterSpace=6.0}\fi
            \strut\insertframesubtitle}%
        \hbox to \textwidth{%
            \begin{minipage}[b]{\dimexpr\textwidth-\wd\decklabelbox-0.8em\relax}
                \raggedright\usebeamerfont{frametitle}\strut\insertframetitle\strut
            \end{minipage}%
            \hfil\box\decklabelbox}%
        \vskip0.9ex
        {\color{maincolor!60}%
            \hrule height 0.4pt
            \vskip1.5pt
            \hrule height 0.4pt}%
    \end{beamercolorbox}
    \vskip1.2ex
}

% title page: the layout template lives in main.tex (it guards empty
% subtitle/author/institute fields); only \maketitle plumbing lives here

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        
        \begin{frame}
            % normal-text fg does not propagate mid-document; force white here
            \usebeamercolor[fg]{normal text}%
            \centering
            \deckrules{white!70!maincolor}{28mm}\par
            \vskip6mm
            {\fontsize{26}{32}\selectfont\scshape
             \ifdefined\addfontfeatures\addfontfeatures{LetterSpace=8.0}\fi
             Q\,\&\,A\par}
            \vskip5mm
            {\large \qaStr\par}
            \vskip6mm
            \deckrules{white!70!maincolor}{28mm}\par
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

% --- commands ---
% set colored hyperlinks command
\newcommand{\bhref}[2]{\textcolor{airforceblue}{\href{#1}{#2}}}

% centering paragraph statement
\newcommand{\centerstate}[1]{
    \centering
    \begin{columns}
        \begin{column}{0.8\textwidth}
            #1
        \end{column}
    \end{columns}
}

\newcommand{\tbf}[1]{\texttt{\textcolor{airforceblue}{[#1]}}}

% coloured textbf
\newcommand{\ctextbf}[1]{\textbf{\textcolor{maincolor}{#1}}}
\newcommand{\btextbf}[1]{\textbf{\textcolor{airforceblue}{#1}}}

% coloured textsl
\newcommand{\ctextsl}[1]{\textit{\textcolor{maincolor}{#1}}}
\newcommand{\btextsl}[1]{\textit{\textcolor{airforceblue}{#1}}}

% coloured emph
\newcommand{\cemph}[1]{\emph{\textcolor{maincolor}{#1}}}
\newcommand{\bemph}[1]{\emph{\textcolor{airforceblue}{#1}}}

% coloured texttt
\newcommand{\ctexttt}[1]{\texttt{\textcolor{maincolor}{#1}}}
\newcommand{\btexttt}[1]{\texttt{\textcolor{airforceblue}{#1}}}
