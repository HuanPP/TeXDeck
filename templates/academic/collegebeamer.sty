\ProvidesPackage{collegeBeamer}

% required packages
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{listings}
\RequirePackage{graphicx}
\RequirePackage{geometry}
\RequirePackage{amsfonts, amsmath, bm, oldgerm, lmodern}  % math
\RequirePackage{verbatim}
\RequirePackage{animate}
\RequirePackage{xcolor}

% --- package options ---
% languages
\newcommand{\tocStr}{Table of Contents}
\newcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}

\DeclareOption{en}{
    \renewcommand{\tocStr}{Table of Contents}
    \renewcommand{\qaStr}{\textsl{Thank you for your attention. \\ Questions and discussion are welcome.}}
}

% colleges & institutes
\newcommand{\maincolorRGB}{128, 57, 61}
\newcommand{\colorlogoPath}{src/brand/color-logo.png}
\newcommand{\translogoPath}{src/brand/trans-logo.png}
\newcommand{\backgroundPath}{src/brand/background.png}

\DeclareOption{bjtu}{
  \renewcommand{\maincolorRGB}{128, 57, 61}  % the theme's main color in RGB
  \renewcommand{\colorlogoPath}{src/brand/color-logo.png}  % path to the logo image with background color
  \renewcommand{\translogoPath}{src/brand/trans-logo.png}  % path to the logo image with transparent background
  \renewcommand{\backgroundPath}{src/brand/background.png}  % path to the background image
}

\ProcessOptions\relax

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% logo
\pgfdeclareimage[width=0.09\paperwidth]{colorlogo}{\colorlogoPath}
\pgfdeclareimage[width=0.09\paperwidth]{translogo}{\translogoPath}
\newcommand{\@makelogo}{colorlogo}

\setbeamertemplate{headline}{\hspace{0.06\textwidth}\pgfuseimage{\@makelogo}} % put the logo in each slide's top left area

% color
\definecolor{maincolor}{RGB}{\maincolorRGB}
\definecolor{airforceblue}{rgb}{0.36, 0.54, 0.66}
\definecolor{morelightgray}{rgb}{0.9, 0.9, 0.9}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=darkgray, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}

% font
% \renewcommand{\familydefault}{\sfdefault}  % sans-serif
\usefonttheme{serif}

\setbeamerfont{title}{series=\bfseries, size=\fontsize{22}{27}\selectfont}

\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{date}{size=\normalsize}

\setbeamerfont{frametitle}{series=\bfseries}
\setbeamerfont{framesubtitle}{series=\mdseries}
\setbeamerfont{footline}{size=\scriptsize}

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% footline: page counter, right-aligned (suppressed on title/section/QA pages
% via the \begingroup overrides around those frames)
\newcommand{\@footlinepayoff}{\insertframenumber\,/\,\inserttotalframenumber}
\setbeamertemplate{footline}{
    \begin{beamercolorbox}[wd=\textwidth, ht=5mm, dp=3mm, rightskip=1cm]{footline}
    \usebeamerfont{footline}\hfill\@footlinepayoff
    \end{beamercolorbox}
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, resets the footline to its plain (no background) look
    \ifstrempty{#1}{
        \renewcommand{\@footlinepayoff}{\insertframenumber\,/\,\inserttotalframenumber}
        \setbeamercolor{footline}{fg=darkgray!70, bg=}
    }{
        \renewcommand{\@footlinepayoff}{\insertframenumber\,/\,\inserttotalframenumber}
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\setbeamercolor{footline}{fg=darkgray!70, bg=}  % default: subtle page numbers

% block (kept strictly on the maincolor palette)
\setbeamertemplate{blocks}[rounded]
\setbeamerfont{block title}{series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamercolor{block title}{fg=white, bg=maincolor}
\setbeamercolor{block body}{fg=darkgray, bg=maincolor!8}
\setbeamercolor{block title alerted}{fg=white, bg=maincolor!80!black}
\setbeamercolor{block body alerted}{fg=darkgray, bg=maincolor!10}
\setbeamercolor{block title example}{fg=white, bg=maincolor!60!black}
\setbeamercolor{block body example}{fg=darkgray, bg=maincolor!60!black!8}

% bullets
\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textemdash}
\setbeamertemplate{itemize subsubitem}{\ensuremath{\circ}}

% table of cotents
\setbeamertemplate{section in toc}{$\blacktriangleright$~\inserttocsection}  % section name format
\setbeamertemplate{subsection in toc}{}  % don't present subsection

% code bolck setting
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    commentstyle=\color{airforceblue},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
}

\lstset{style=mystyle}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame; suppressed before the first \section so no
% stray "0" appears under early frame titles (e.g. the Outline page)
\makeatletter
    \pretocmd\beamer@checkframetitle{\framesubtitle{\ifnum\value{section}>0 \thesection\,\secname\fi}}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section page with the current section highlighted
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \themecolor{colorbg}
    \begin{frame}{\tocStr}
        \tableofcontents[currentsection]
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begin{frame}{\,}{\thesection \, \secname}
        \fontfamily{ptm}\selectfont
        \centering\textsl{\textbf{\textcolor{maincolor}{
            \large Section \thesection.\thesubsection
            \vskip15pt
            \LARGE \subsecname
        }}}
    \end{frame}
}

% --- page elements ---
% frame title & subtitle layout
\setbeamertemplate{frametitle}{
    \vspace*{-3.5ex}
    \begin{beamercolorbox}[leftskip=2cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\\
    \usebeamerfont{framesubtitle}\insertframesubtitle
    \end{beamercolorbox}
}

% title page: the layout template lives in main.tex (it guards empty
% subtitle/author/institute fields); only \maketitle plumbing lives here

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        
        \begin{frame}{}
            \centering
            \begin{minipage}{\textwidth}
                \usebeamercolor[fg]{normal text}
                \centering
                {\fontsize{30}{36}\selectfont\bfseries Q\,\&\,A\par}
                \vspace{1em}
                {\Large \qaStr\par}
            \end{minipage}
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

% --- commands ---
% set colored hyperlinks command
\newcommand{\bhref}[2]{\textcolor{airforceblue}{\href{#1}{#2}}}

% centering paragraph statement
\newcommand{\centerstate}[1]{
    \centering
    \begin{columns}
        \begin{column}{0.8\textwidth}
            #1
        \end{column}
    \end{columns}
}

\newcommand{\tbf}[1]{\texttt{\textcolor{airforceblue}{[#1]}}}

% coloured textbf
\newcommand{\ctextbf}[1]{\textbf{\textcolor{maincolor}{#1}}}
\newcommand{\btextbf}[1]{\textbf{\textcolor{airforceblue}{#1}}}

% coloured textsl
\newcommand{\ctextsl}[1]{\textsl{\textcolor{maincolor}{#1}}}
\newcommand{\btextsl}[1]{\textsl{\textcolor{airforceblue}{#1}}}

% coloured emph
\newcommand{\cemph}[1]{\emph{\textcolor{maincolor}{#1}}}
\newcommand{\bemph}[1]{\emph{\textcolor{airforceblue}{#1}}}

% coloured texttt
\newcommand{\ctexttt}[1]{\texttt{\textcolor{maincolor}{#1}}}
\newcommand{\btexttt}[1]{\texttt{\textcolor{airforceblue}{#1}}}
