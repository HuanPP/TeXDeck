\newif\ifcollegebeamer@zh

% Chinese option
\DeclareOption{zh}{%
  \collegebeamer@zhtrue
  \AtEndOfPackage{%
    \RequirePackage{ifxetex}
    \RequirePackage{xeCJK}

    % TeXDeck: xeCJK otherwise treats curly quotes as CJK punctuation and pads
    % them to full width, which looks wrong in English text (dollar's -> dollar ' s).
    \xeCJKDeclareCharClass{Default}{"2018, "2019, "201C, "201D}

    % Swiss typography: grotesque sans throughout. TeX Gyre Heros is the
    % free Helvetica clone; both families point at it so the deck is sans-first
    % no matter which family a generated deck selects.
    \setmainfont[Path=./font/,
      BoldFont       = texgyreheros-bold.otf,
      ItalicFont     = texgyreheros-italic.otf,
      BoldItalicFont = texgyreheros-bolditalic.otf,
    ]{texgyreheros-regular.otf}
    \setsansfont[Path=./font/,
      BoldFont       = texgyreheros-bold.otf,
      ItalicFont     = texgyreheros-italic.otf,
      BoldItalicFont = texgyreheros-bolditalic.otf,
    ]{texgyreheros-regular.otf}

    % CJK: Hei (黑体) is the Chinese grotesque — the Helvetica analogue.
    % FandolHei ships a real Bold, so no fake bolding is needed.
    % Prefer Noto/Source Han when installed (Docker ships fonts-noto-cjk);
    % fall back to FandolHei so a plain TeX Live still compiles.
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \setCJKmainfont{Noto Sans CJK SC}[BoldFont = {* Bold}]%
      \setCJKsansfont{Noto Sans CJK SC}[BoldFont = {* Bold}]%
    }{\IfFontExistsTF{Source Han Sans SC}{%
      \setCJKmainfont{Source Han Sans SC}[BoldFont = {* Bold}]%
      \setCJKsansfont{Source Han Sans SC}[BoldFont = {* Bold}]%
    }{%
      \setCJKmainfont{FandolHei-Regular}[
        Extension = .otf,
        BoldFont  = FandolHei-Bold.otf
      ]
      \setCJKsansfont{FandolHei-Regular}[
        Extension = .otf,
        BoldFont  = FandolHei-Bold.otf
      ]
    }}

    \renewcommand{\qaStr}{Thank you for your attention. \\ Questions and discussion are welcome.}
    \ifxetex
    \else
      \PackageError{collegeBeamer}{Compile this template with XeLaTeX}{}
    \fi
  }
}

