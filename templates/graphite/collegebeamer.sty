% --- typeset & elements settings ---
\geometry{paperwidth=16cm,paperheight=9cm}

% logo
% Logos fit a box of at most #2 x #3 and keep their aspect ratio, so a logo
% of any shape (a custom one included) stays inside its slot.
\newcommand{\tddeclarelogo}[4]{%
  \setbox0=\hbox{\includegraphics[width=#2,height=#3,keepaspectratio]{#4}}%
  \edef\td@logo@args{[width=\the\wd0,height=\the\ht0]{#1}{#4}}%
  \expandafter\pgfdeclareimage\td@logo@args}
\tddeclarelogo{colorlogo}{2.5\dimexpr0.082\paperwidth\relax}{0.082\paperwidth}{\colorlogoPath}
\tddeclarelogo{translogo}{2.5\dimexpr0.082\paperwidth\relax}{0.082\paperwidth}{\translogoPath}
\newcommand{\@makelogo}{colorlogo}

% Logo lives top-right so frametitle, subtitle and body share one left edge.
\setbeamertemplate{headline}{%
  \vspace{0.03\paperheight}%
  \hbox to \paperwidth{\hfil\pgfuseimage{\@makelogo}\hspace{0.035\paperwidth}}%
}

% color — monochrome ramp; near-black IS the accent
\definecolor{maincolor}{RGB}{\maincolorRGB}
\definecolor{airforceblue}{RGB}{90, 90, 96}
\definecolor{morelightgray}{RGB}{242, 242, 244}
\definecolor{reporttext}{RGB}{38, 38, 42}
\definecolor{reportmuted}{RGB}{110, 110, 116}
\definecolor{reportline}{RGB}{214, 214, 218}

\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \renewcommand{\@makelogo}{translogo}
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
    }{
        \renewcommand{\@makelogo}{colorlogo}
        \setbeamercolor{normal text}{fg=reporttext, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
    }
}
\themecolor{white}

\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=reporttext}
\setbeamercolor{date}{fg=reportmuted}
\setbeamercolor{frametitle}{fg=maincolor}
\setbeamercolor{framesubtitle}{fg=reportmuted}

% font — sans-first (Swiss)
\renewcommand{\familydefault}{\sfdefault}
\usefonttheme{professionalfonts}

\AtEndOfPackage{%
  \ifcollegebeamer@zh
    \setbeamerfont{title}{series=\bfseries, size={\fontsize{30}{35}}}
  \else
    \setbeamerfont{title}{series=\bfseries, size={\fontsize{30}{35}}}
  \fi
}

\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize}
\setbeamerfont{author}{size=\small}
\setbeamerfont{date}{size=\footnotesize}
\setbeamerfont{frametitle}{series=\bfseries, size={\fontsize{15}{18}}}
\setbeamerfont{framesubtitle}{series=\mdseries, size=\tiny}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\footnotesize}

\setbeamertemplate{navigation symbols}{}

% footline: hairline + right-aligned frame counter (always shown)
\newcommand{\@footlinepayoff}{}
\setbeamertemplate{footline}{
    \begin{beamercolorbox}[wd=\textwidth, ht=4.8mm, dp=2.5mm, leftskip=1cm, rightskip=1cm]{footline}
    \color{reportline}\rule{\dimexpr\textwidth-2cm\relax}{0.25pt}\par\vspace{-0.15ex}
    \usebeamerfont{footline}\usebeamercolor[fg]{footline}\@footlinepayoff\hfill\insertframenumber\,/\,\inserttotalframenumber
    \end{beamercolorbox}
}

\newcommand{\footlinecolor}[1]{
    \ifstrempty{#1}{
        \renewcommand{\@footlinepayoff}{}
        \setbeamercolor{footline}{fg=reportmuted, bg=}
    }{
        \renewcommand{\@footlinepayoff}{\insertshorttitle}
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{}

% block — square Swiss panels, no rounding, no shadow
\setbeamertemplate{blocks}[default]
\setbeamercolor{block title}{fg=white, bg=maincolor}
\setbeamercolor{block body}{fg=reporttext, bg=morelightgray}

% bullets — small filled squares, en-dash second level
\setbeamertemplate{itemize item}{\raisebox{0.28ex}{\textcolor{maincolor}{\rule{4.5pt}{4.5pt}}}}
\setbeamertemplate{itemize subitem}{\textcolor{reportmuted}{\textendash}}
\setbeamertemplate{itemize subsubitem}{\textcolor{reportmuted}{\tiny$\circ$}}

% table of contents
\setbeamertemplate{section in toc}{\raisebox{0.28ex}{\textcolor{maincolor}{\rule{4.5pt}{4.5pt}}}~\inserttocsection}
\setbeamertemplate{subsection in toc}{}

% code block setting — neutral grays only
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.35,0.35,0.38}
\definecolor{backcolour}{rgb}{0.955,0.955,0.96}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{airforceblue},
    keywordstyle=\color{maincolor},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    xleftmargin=10pt,
    xrightmargin=10pt,
    frame=single,
    rulecolor=\color{reportline},
}

\lstset{style=mystyle}

% --- section & frame setting ---
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% Every content frame carries "NN  SECTION NAME" as an eyebrow line under the
% frametitle bar. Zero-padded to match the giant section numerals.
\makeatletter
    \pretocmd\beamer@checkframetitle{\framesubtitle{\two@digits{\value{section}}\hspace{0.7em}\secname}}{}
\makeatother

\setbeamertemplate{frametitle continuation}{}

\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \begin{frame}{\tocStr}
        \tableofcontents[currentsection]
    \end{frame}
    \endgroup
}

\makeatletter
\AtBeginSubsection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \begin{frame}[plain,t]
        \vspace*{0.18\paperheight}
        {\fontsize{90}{90}\selectfont\bfseries\textcolor{black!8}{\two@digits{\value{section}}.\two@digits{\value{subsection}}}\par}
        \vspace{-11mm}
        \textcolor{maincolor}{\rule{12mm}{4mm}}\par
        \vspace{8pt}
        {\fontsize{20}{24}\selectfont\bfseries\textcolor{maincolor}{\subsecname}\par}
    \end{frame}
    \endgroup
}
\makeatother

% --- page elements ---
% Frametitle: bold sans headline, thick short near-black bar under it, then the
% section eyebrow in tiny letterspaced caps. Everything flush left on the 1cm
% body margin. The eyebrow is guarded so frames before the first \section never
% print a bare "00".
\setbeamertemplate{frametitle}{
    \vspace*{0.45ex}
    \begin{beamercolorbox}[sep=0pt]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    \vspace*{0.6ex}
    \textcolor{maincolor}{\rule{10mm}{1.2mm}}\par
    \ifnum\value{section}>0
        \vspace*{0.5ex}
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
         \addfontfeature{LetterSpace=16.0}\MakeUppercase{\insertframesubtitle}\par}
    \fi
    \end{beamercolorbox}
    \vspace*{0.35ex}
}

% Title page: hard grid, top-left anchored. Thick 12x4mm near-black bar above a
% huge bold flush-left title; metadata in a tight stack below; small date pinned
% bottom-left. Subtitle/author lines vanish when their fields are empty.
\makeatletter
\setbeamertemplate{title page}{
    % Fixed-height box: the metadata stack hangs from the top, the date is
    % pinned bottom-left regardless of which metadata fields are filled.
    \vbox to 0.77\paperheight{%
        \vskip0.055\paperheight
        \begin{beamercolorbox}[wd=0.82\textwidth, sep=0pt]{title}
            \textcolor{maincolor}{\rule{12mm}{4mm}}\\[16pt]
            {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}\\
            \ifx\insertsubtitle\@empty\else
                \vskip9pt{\usebeamerfont{subtitle}\textcolor{reportmuted}{\insertsubtitle}}\\
            \fi
            \ifx\beamer@shortauthor\@empty\else
                \vskip7pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\
            \fi
        \end{beamercolorbox}
        \vfil
        {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
    }%
}
\makeatother

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}[t]
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A: white Swiss page — ghost lettering, thick bar, bold headline.
% No full-bleed color page (that is the navy/emerald move, not graphite's).
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \begin{frame}[plain,t]
            \vspace*{0.18\paperheight}
            {\fontsize{90}{90}\selectfont\bfseries\textcolor{black!8}{Q\&A}\par}
            \vspace{-11mm}
            \textcolor{maincolor}{\rule{12mm}{4mm}}\par
            \vspace{8pt}
            {\fontsize{20}{24}\selectfont\bfseries\textcolor{maincolor}{Q \& A}\par}
            \vspace{6pt}
            {\small\textcolor{reportmuted}{\qaStr}\par}
        \end{frame}
    \endgroup
}

\newcommand{\bibliographpage}{
    \section{References}
    \begingroup
    \begin{frame}[allowframebreaks]{References}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

