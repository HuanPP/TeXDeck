# LLM (required)
# API key; required — generation will not work without it
TEXDECK_LLM_API_KEY=
# API base URL; default Moonshot
TEXDECK_LLM_BASE_URL=https://api.moonshot.cn/v1
# Model name; MUST be vision-capable. Verified working: moonshot-v1-128k-vision-preview
# Note: kimi-k2.6 / kimi-k3 force temperature=1, while this project uses 0.2,
# so do not configure those models (and do not special-case temperature by model name).
TEXDECK_LLM_MODEL=moonshot-v1-128k-vision-preview
# Per-call timeout (seconds)
TEXDECK_LLM_TIMEOUT_SECONDS=900
# OpenAI SDK network-layer retry count
TEXDECK_LLM_MAX_RETRIES=2

# Paths
# Templates root directory
TEXDECK_TEMPLATES_DIR=
# Generation artifacts root directory
TEXDECK_ARTIFACT_ROOT=

# PDF processing
# DPI for high-res page images sent to generation
TEXDECK_PDF_RENDER_DPI=150
# DPI for page-selection thumbnails
TEXDECK_PDF_THUMBNAIL_DPI=60
# Trigger page selection above this page count
TEXDECK_PDF_MAX_VISION_PAGES=40

# LaTeX compilation
# xelatex executable name or path
TEXDECK_XELATEX_COMMAND=xelatex
# Per-invocation xelatex timeout (seconds)
TEXDECK_XELATEX_TIMEOUT_SECONDS=120
# Max model repair attempts after a compile failure
TEXDECK_MAX_COMPILE_REPAIRS=2
