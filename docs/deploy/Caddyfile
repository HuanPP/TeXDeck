# Browser -> Cloudflare (proxied, Origin Rule rewrites the port to 2083) -> this Caddy -> TeXDeck on 127.0.0.1:8790.
# The certificate is a Cloudflare origin certificate, trusted only by Cloudflare; run the zone in Full (strict).
{
	admin off
	auto_https off
}

https://texdeck.example.com:2083 {
	tls /srv/texdeck/certs/origin.pem /srv/texdeck/certs/origin.key
	request_body {
		max_size 110MB
	}
	reverse_proxy 127.0.0.1:8790 {
		flush_interval -1
	}
}
