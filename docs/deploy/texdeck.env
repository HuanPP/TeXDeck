# Example settings for a server install; see docs/deploy/README.md.
TEXDECK_ARTIFACT_ROOT=/srv/texdeck/data/artifacts
TEXDECK_USERS_FILE=/srv/texdeck/data/users.json
# Invite-code sign-up; the first account signs up with hi_my_texdeck and becomes the admin.
TEXDECK_REGISTRATION=true
TEXDECK_MODEL_STATE_FILE=/srv/texdeck/data/model-state.json
TEXDECK_CHATGPT_AUTH_FILE=/srv/texdeck/data/chatgpt-auth.json
TEXDECK_TEX_ENGINE=tectonic
TEXDECK_TECTONIC_COMMAND=/srv/texdeck/bin/tectonic
